filters:
  and:
    - type == "cfp"
formulas:
  cfp_title: link(file.path, if(event_name, event_name, file.name))
  submission_count: 'list(submissions).length'
  # Folder constants — the match is a suffix, so these work whether your vault
  # stores the notes at `cfps/data` or at `30-speaking-talks/cfps/data`.
  # Change them only if the folders themselves are named differently.
  data_dir: '"cfps/data/"'
  archived_dir: '"cfps/archived/"'
  # Personal location settings for the My Country and My Local Area views.
  # Use the canonical country value from your notes, such as "USA" or "UK".
  my_country: '"USA"'
  # Add or remove location.contains(...) clauses to define your local area.
  is_local_area: >-
    location.contains("San Francisco") ||
    location.contains("San Jose") ||
    location.contains("Oakland") ||
    location.contains("Berkeley") ||
    location.contains("Santa Clara") ||
    location.contains("Sunnyvale") ||
    location.contains("Palo Alto") ||
    location.contains("Mountain View") ||
    location.contains("Cupertino") ||
    location.contains("Redwood") ||
    location.contains("Menlo Park") ||
    location.contains("San Mateo") ||
    location.contains("Milpitas") ||
    location.contains("Fremont") ||
    location.contains("Hayward") ||
    location.contains("Emeryville") ||
    location.contains("Los Altos") ||
    location.contains("Los Gatos") ||
    location.contains("Pleasanton") ||
    location.contains("Livermore") ||
    location.contains("Bay Area")
  # The predicates every view below filters on, so no view repeats a path.
  is_in_data: '("/" + file.path).contains("/" + formula.data_dir)'
  is_archived: '("/" + file.path).contains("/" + formula.archived_dir)'
  is_dismissed: 'dismissed == true || dismissed == "true"'
  is_live: 'formula.is_in_data && !formula.is_dismissed'
  # Curated ranking stamped by src/apply-prestige.py from prestige.md
  # (1 = flagship, 2 = major, 3 = notable). Absent -> not ranked.
  is_prestigious: 'tier == 1 || tier == 2'
properties:
  formula.cfp_title:
    displayName: Event
  formula.submission_count:
    displayName: Submissions
  dismissed:
    displayName: Dismissed
  shortlist:
    displayName: Shortlist
  tier:
    displayName: Tier
  country:
    displayName: Country
  event_date:
    displayName: Event date
  location:
    displayName: Location
  conflict:
    displayName: Conflict
  cfp_close:
    displayName: CFP close
  updated:
    displayName: Updated
  topics:
    displayName: Topics
  cfp_url:
    displayName: CFP link
  event_url:
    displayName: Event link
views:
  - type: table
    name: Search
    filters:
      and:
        - 'formula.is_in_data'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      formula.cfp_title: 274
      note.location: 201
      note.topics: 181
  - type: table
    name: Conflicts
    filters:
      and:
        - 'formula.is_in_data'
        - 'conflict == true'
    order:
      - cfp_close
      - formula.cfp_title
      - location
      - country
      - source
      - updated
    sort:
      - property: updated
        direction: DESC
    columnSize:
      note.cfp_close: 129
      formula.cfp_title: 274
      note.location: 201
      note.updated: 180
  - type: table
    name: All (+dismissed)
    filters:
      and:
        - 'formula.is_in_data'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      formula.cfp_title: 274
      note.location: 201
      note.topics: 181
      note.event_url: 153
      note.cfp_url: 169
  - type: table
    name: All (-dismissed)
    filters:
      and:
        - 'formula.is_live'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      formula.cfp_title: 274
      note.location: 201
      note.topics: 181
      note.event_url: 153
      note.cfp_url: 169
  - type: table
    name: Prestigious (+dismissed)
    filters:
      and:
        - 'formula.is_in_data'
        - 'formula.is_prestigious'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: tier
        direction: ASC
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      note.tier: 56
      formula.cfp_title: 274
      note.location: 201
  - type: table
    name: Prestigious (-dismissed)
    filters:
      and:
        - 'formula.is_live'
        - 'formula.is_prestigious'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: tier
        direction: ASC
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      note.tier: 56
      formula.cfp_title: 274
      note.location: 201
  - type: table
    name: Recently Updated (+dismissed)
    filters:
      and:
        - 'formula.is_in_data'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - updated
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: updated
        direction: DESC
    columnSize:
      note.cfp_close: 109
      note.tier: 58
      note.shortlist: 42
      note.dismissed: 67
      formula.cfp_title: 274
      note.event_date: 139
      note.location: 201
      note.topics: 181
      note.event_url: 212
      note.cfp_url: 253
  - type: table
    name: Recently Updated (-dismissed)
    filters:
      and:
        - 'formula.is_live'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - updated
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: updated
        direction: DESC
  - type: table
    name: Short listed
    filters:
      and:
        - shortlist == true
        - 'formula.is_in_data'
    order:
      - cfp_close
      - tier
      - shortlist
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Submitted
    filters:
      and:
        - list(submissions).length > 0
        - 'formula.is_in_data'
    order:
      - cfp_close
      - tier
      - shortlist
      - formula.submission_count
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      formula.cfp_title: 274
      note.location: 159
      note.topics: 181
      note.event_url: 153
      note.cfp_url: 169
  - type: table
    name: Upcoming (> -30 days) (+dismissed)
    filters:
      and:
        - cfp_close >= today() - "30d"
        - 'formula.is_in_data'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Upcoming (> -30 days) (-dismissed)
    filters:
      and:
        - cfp_close >= today() - "30d"
        - 'formula.is_live'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Upcoming (> today) (+dismissed)
    filters:
      and:
        - cfp_close >= today()
        - 'formula.is_in_data'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
      - languages
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      note.shortlist: 65
      formula.cfp_title: 250
      note.location: 205
      note.topics: 181
      note.event_url: 212
      note.cfp_url: 253
  - type: table
    name: Upcoming (> today) (-dismissed)
    filters:
      and:
        - cfp_close >= today()
        - 'formula.is_live'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
      - languages
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      note.shortlist: 65
      formula.cfp_title: 250
      note.location: 205
      note.topics: 181
      note.event_url: 212
      note.cfp_url: 253
  - type: table
    name: Closed (90d) (+dismissed)
    filters:
      and:
        - cfp_close < today() - "30d"
        - cfp_close >= today() - "90d"
        - 'formula.is_in_data'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Closed (90d) (-dismissed)
    filters:
      and:
        - cfp_close < today() - "30d"
        - cfp_close >= today() - "90d"
        - 'formula.is_live'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Location - My Country (+dismissed)
    filters:
      and:
        - country == formula.my_country
        - 'formula.is_in_data'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Location - My Country (-dismissed)
    filters:
      and:
        - country == formula.my_country
        - 'formula.is_live'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Location - Outside My Country (+dismissed)
    filters:
      and:
        - country != formula.my_country
        - 'formula.is_in_data'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Location - Outside My Country (-dismissed)
    filters:
      and:
        - country != formula.my_country
        - 'formula.is_live'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Location - Online (+dismissed)
    filters:
      and:
        - country == "Online"
        - 'formula.is_in_data'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.event_date: 139
      note.location: 127
  - type: table
    name: Location - Online (-dismissed)
    filters:
      and:
        - country == "Online"
        - 'formula.is_live'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.event_date: 139
      note.location: 127
  - type: table
    name: Location - My Local Area (+dismissed)
    filters:
      and:
        - 'formula.is_in_data'
        - 'formula.is_local_area'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      formula.cfp_title: 274
      note.location: 245
      note.cfp_url: 253
      note.event_url: 212
  - type: table
    name: Location - My Local Area (-dismissed)
    filters:
      and:
        - 'formula.is_live'
        - 'formula.is_local_area'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      formula.cfp_title: 274
      note.location: 245
      note.cfp_url: 253
      note.event_url: 212
  - type: table
    name: Dismissed
    filters:
      and:
        - 'formula.is_in_data'
        - 'formula.is_dismissed'
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Archived
    filters:
      and:
        - formula.is_archived
    order:
      - cfp_close
      - tier
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: DESC
