filters:
  and:
    - type == "cfp"
formulas:
  cfp_title: link(file.path, if(name, name, file.name))
  # Folder constants — the match is a suffix, so these work whether your vault
  # stores the notes at `cfps/data` or at `30-speaking-talks/cfps/data`.
  # Change them only if the folders themselves are named differently.
  data_dir: '"cfps/data/"'
  archived_dir: '"cfps/archived/"'
  # The predicates every view below filters on, so no view repeats a path.
  is_in_data: '("/" + file.path).contains("/" + formula.data_dir)'
  is_archived: '("/" + file.path).contains("/" + formula.archived_dir)'
  is_dismissed: 'dismissed == true || dismissed == "true"'
  is_live: 'formula.is_in_data && !formula.is_dismissed'
properties:
  formula.cfp_title:
    displayName: Event
  dismissed:
    displayName: Dismissed
  shortlist:
    displayName: Shortlist
  country:
    displayName: Country
  event_date:
    displayName: Event date
  location:
    displayName: Location
  cfp_close:
    displayName: CFP close
  topics:
    displayName: Topics
  cfp_url:
    displayName: CFP link
  event_url:
    displayName: Event link
views:
  - type: table
    name: All (+dismissed)
    filters:
      and:
        - 'formula.is_in_data'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      formula.cfp_title: 274
      note.location: 201
      note.topics: 181
      note.event_url: 153
      note.cfp_url: 169
  - type: table
    name: All (-dismissed)
    filters:
      and:
        - 'formula.is_live'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      formula.cfp_title: 274
      note.location: 201
      note.topics: 181
      note.event_url: 153
      note.cfp_url: 169
  - type: table
    name: Short listed (+dismissed)
    filters:
      and:
        - shortlist == true
        - 'formula.is_in_data'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Short listed (-dismissed)
    filters:
      and:
        - shortlist == true
        - 'formula.is_live'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Submitted (+dismissed)
    filters:
      and:
        - list(submissions).length > 0
        - 'formula.is_in_data'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      formula.cfp_title: 274
      note.location: 159
      note.topics: 181
      note.event_url: 153
      note.cfp_url: 169
  - type: table
    name: Submitted (-dismissed)
    filters:
      and:
        - list(submissions).length > 0
        - 'formula.is_live'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      formula.cfp_title: 274
      note.location: 159
      note.topics: 181
      note.event_url: 153
      note.cfp_url: 169
  - type: table
    name: Upcoming (> -30 days) (+dismissed)
    filters:
      and:
        - cfp_close >= today() - "30d"
        - 'formula.is_in_data'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Upcoming (> -30 days) (-dismissed)
    filters:
      and:
        - cfp_close >= today() - "30d"
        - 'formula.is_live'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Upcoming (> today) (+dismissed)
    filters:
      and:
        - cfp_close >= today()
        - 'formula.is_in_data'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
      - languages
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      note.shortlist: 65
      formula.cfp_title: 250
      note.location: 205
      note.topics: 181
      note.event_url: 212
      note.cfp_url: 253
  - type: table
    name: Upcoming (> today) (-dismissed)
    filters:
      and:
        - cfp_close >= today()
        - 'formula.is_live'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
      - languages
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      note.shortlist: 65
      formula.cfp_title: 250
      note.location: 205
      note.topics: 181
      note.event_url: 212
      note.cfp_url: 253
  - type: table
    name: Closed (90d) (+dismissed)
    filters:
      and:
        - cfp_close < today() - "30d"
        - cfp_close >= today() - "90d"
        - 'formula.is_in_data'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Closed (90d) (-dismissed)
    filters:
      and:
        - cfp_close < today() - "30d"
        - cfp_close >= today() - "90d"
        - 'formula.is_live'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Conf in USA (+dismissed)
    filters:
      and:
        - country == "USA"
        - 'formula.is_in_data'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Conf in USA (-dismissed)
    filters:
      and:
        - country == "USA"
        - 'formula.is_live'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Conf outside USA (+dismissed)
    filters:
      and:
        - country != "USA"
        - 'formula.is_in_data'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Conf outside USA (-dismissed)
    filters:
      and:
        - country != "USA"
        - 'formula.is_live'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Online (+dismissed)
    filters:
      and:
        - country == "Online"
        - 'formula.is_in_data'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.event_date: 139
      note.location: 127
  - type: table
    name: Online (-dismissed)
    filters:
      and:
        - country == "Online"
        - 'formula.is_live'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.event_date: 139
      note.location: 127
  - type: table
    name: Local events (+dismissed)
    filters:
      and:
        - 'formula.is_in_data'
        - or:
            - location.contains("San Francisco")
            - location.contains("San Jose")
            - location.contains("Oakland")
            - location.contains("Berkeley")
            - location.contains("Santa Clara")
            - location.contains("Sunnyvale")
            - location.contains("Palo Alto")
            - location.contains("Mountain View")
            - location.contains("Cupertino")
            - location.contains("Redwood")
            - location.contains("Menlo Park")
            - location.contains("San Mateo")
            - location.contains("Milpitas")
            - location.contains("Fremont")
            - location.contains("Hayward")
            - location.contains("Emeryville")
            - location.contains("Los Altos")
            - location.contains("Los Gatos")
            - location.contains("Pleasanton")
            - location.contains("Livermore")
            - location.contains("Bay Area")
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      formula.cfp_title: 274
      note.location: 245
      note.cfp_url: 253
      note.event_url: 212
  - type: table
    name: Local events (-dismissed)
    filters:
      and:
        - 'formula.is_live'
        - or:
            - location.contains("San Francisco")
            - location.contains("San Jose")
            - location.contains("Oakland")
            - location.contains("Berkeley")
            - location.contains("Santa Clara")
            - location.contains("Sunnyvale")
            - location.contains("Palo Alto")
            - location.contains("Mountain View")
            - location.contains("Cupertino")
            - location.contains("Redwood")
            - location.contains("Menlo Park")
            - location.contains("San Mateo")
            - location.contains("Milpitas")
            - location.contains("Fremont")
            - location.contains("Hayward")
            - location.contains("Emeryville")
            - location.contains("Los Altos")
            - location.contains("Los Gatos")
            - location.contains("Pleasanton")
            - location.contains("Livermore")
            - location.contains("Bay Area")
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
    columnSize:
      note.cfp_close: 129
      formula.cfp_title: 274
      note.location: 245
      note.cfp_url: 253
      note.event_url: 212
  - type: table
    name: Dismissed (+dismissed)
    filters:
      and:
        - 'formula.is_in_data'
        - 'formula.is_dismissed'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Dismissed (-dismissed)
    filters:
      and:
        - 'formula.is_in_data'
        - 'formula.is_dismissed'
        - '!formula.is_dismissed'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: ASC
  - type: table
    name: Archived (+dismissed)
    filters:
      and:
        - formula.is_archived
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: DESC
  - type: table
    name: Archived (-dismissed)
    filters:
      and:
        - formula.is_archived
        - '!formula.is_dismissed'
    order:
      - cfp_close
      - shortlist
      - dismissed
      - formula.cfp_title
      - event_date
      - location
      - topics
      - source
      - event_url
      - cfp_url
    sort:
      - property: cfp_close
        direction: DESC
